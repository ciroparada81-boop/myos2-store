// CRONOMETRO - Espacio: iniciar/pausar. L: vuelta. R: reiniciar. ESC: salir.
window(460, 360, "Cronometro");
var segs = ["abcdef", "bc", "abdeg", "abcdg", "bcfg", "acdfg", "acdefg", "abc", "abcdefg", "abcdfg"];
var running = false;
var base = 0;
var started_at = 0;
var laps = [];

fn elapsed() {
    if (running) { return base + time() - started_at; }
    return base;
}

fn has(s, ch) { return find(s, ch) >= 0; }

fn digit(d, x, y, c) {
    var s = segs[d];
    var T = 6;
    var L = 34;
    var dim = rgb(34, 38, 58);
    var on = "";
    if (has(s, "a")) { fill(x + T, y, L, T, c); } else { fill(x + T, y, L, T, dim); }
    if (has(s, "b")) { fill(x + T + L, y + T, T, L, c); } else { fill(x + T + L, y + T, T, L, dim); }
    if (has(s, "c")) { fill(x + T + L, y + 2 * T + L, T, L, c); } else { fill(x + T + L, y + 2 * T + L, T, L, dim); }
    if (has(s, "d")) { fill(x + T, y + 2 * T + 2 * L, L, T, c); } else { fill(x + T, y + 2 * T + 2 * L, L, T, dim); }
    if (has(s, "e")) { fill(x, y + 2 * T + L, T, L, c); } else { fill(x, y + 2 * T + L, T, L, dim); }
    if (has(s, "f")) { fill(x, y + T, T, L, c); } else { fill(x, y + T, T, L, dim); }
    if (has(s, "g")) { fill(x + T, y + T + L, L, T, c); } else { fill(x + T, y + T + L, L, T, dim); }
}

fn pad2(n) { if (n < 10) { return "0" + str(n); } return str(n); }

fn fmt(ms) {
    var cs = (ms / 10) % 100;
    var s = (ms / 1000) % 60;
    var m = (ms / 60000) % 100;
    return pad2(m) + ":" + pad2(s) + "." + pad2(cs);
}

fn draw() {
    clear(rgb(14, 17, 30));
    var ms = elapsed();
    var cs = (ms / 10) % 100;
    var s = (ms / 1000) % 60;
    var m = (ms / 60000) % 100;
    var c = rgb(110, 240, 190);
    if (!running && ms > 0) { c = rgb(255, 190, 90); }
    var x = 14;
    digit(m / 10, x, 20, c); x += 52;
    digit(m % 10, x, 20, c); x += 52;
    fill(x + 4, 50, 6, 6, c); fill(x + 4, 86, 6, 6, c); x += 20;
    digit(s / 10, x, 20, c); x += 52;
    digit(s % 10, x, 20, c); x += 52;
    fill(x + 4, 96, 6, 6, c); x += 20;
    digit(cs / 10, x, 20, c); x += 52;
    digit(cs % 10, x, 20, c);
    var estado = "Detenido";
    if (running) { estado = "En marcha"; }
    text(14, 134, estado + "   |   Espacio: iniciar/pausar   L: vuelta   R: reiniciar", GRAY);
    var n = len(laps);
    var first = max(0, n - 8);
    for (var i = first; i < n; i++) {
        var prev = 0;
        if (i > 0) { prev = laps[i - 1]; }
        text(30, 164 + (i - first) * 22, "Vuelta " + str(i + 1) + "   " + fmt(laps[i]) + "   (+" + fmt(laps[i] - prev) + ")", WHITE);
    }
    flip();
}

while (true) {
    var k = key(30);
    if (k == KEY_ESC) { break; }
    if (k == KEY_SPACE) {
        if (running) { base = elapsed(); running = false; }
        else { started_at = time(); running = true; }
    }
    if ((k == 108 || k == 76) && running) { push(laps, elapsed()); }
    if (k == 114 || k == 82) { running = false; base = 0; laps = []; }
    draw();
}
